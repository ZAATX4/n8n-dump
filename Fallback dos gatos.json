    {
      "parameters": {
        "jsCode": "// Pega todos os itens que chegaram (30 itens)\nconst allItems = $input.all();\n\n// Se não houver itens, interrompe\nif (allItems.length === 0) {\n  return [];\n}\n\n// Cria um Map para armazenar os itens únicos, usando o número da linha como chave\nconst uniqueMap = new Map();\n\nallItems.forEach(item => {\n  const rowNumber = item.json._row_number; // campo adicionado pelo Get Rows\n  if (!uniqueMap.has(rowNumber)) {\n    uniqueMap.set(rowNumber, item);\n  }\n});\n\n// Converte o Map de volta para um array de itens\nconst uniqueItems = Array.from(uniqueMap.values());\n\n// Retorna os itens únicos (agora apenas 3)\nreturn uniqueItems;"
      },
